---
// The Operant mark: the logo in white on an orange square.
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<span class="inline-flex shrink-0 items-center justify-center bg-brand" style={`width:${size}px;height:${size}px`}>
  <img src="/logo.png" alt="" width={Math.round(size * 0.7)} height={Math.round(size * 0.7)} style="filter: brightness(0) invert(1)" />
</span>
