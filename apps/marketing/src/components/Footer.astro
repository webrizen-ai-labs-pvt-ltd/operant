---
import { demoUrl, SITE, signUpUrl } from "../site";
import Mark from "./Mark.astro";
const year = new Date().getFullYear();
const cols = [
  ["Product", [["Product", "/#product"], ["Finance", "/#finance"], ["How it works", "/#how"], ["Try the calculators", "/#try"]]],
  ["Start", [["Get started", signUpUrl], ["Sign in", SITE.appUrl], ["Book a demo", demoUrl], ["Questions", "/#faq"]]],
] as const;
---

<footer class="border-t border-line">
  <div class="mx-auto grid max-w-[1200px] gap-10 px-5 py-14 sm:px-8 md:grid-cols-[2fr_1fr_1fr]">
    <div>
      <a href="/" class="flex items-center gap-2.5 font-semibold"><Mark /> {SITE.name}</a>
      <p class="mt-4 max-w-sm text-sm text-ink-3">{SITE.tagline} Made in India by {SITE.maker}.</p>
      <a href={`mailto:${SITE.contactEmail}`} class="mt-4 inline-block text-sm text-ink-2 hover:text-brand">{SITE.contactEmail}</a>
    </div>
    {
      cols.map(([title, items]) => (
        <div>
          <div class="text-sm font-semibold">{title}</div>
          <ul class="mt-4 space-y-2.5 text-sm">
            {items.map(([label, href]) => (
              <li>
                <a href={href} class="text-ink-3 hover:text-ink">
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="border-t border-line">
    <div class="mx-auto flex max-w-[1200px] flex-wrap justify-between gap-2 px-5 py-5 text-xs text-ink-3 sm:px-8">
      <span>© {year} {SITE.maker} Pvt Ltd</span>
      <span>Sign-in by Webrizen SSO</span>
    </div>
  </div>
</footer>
