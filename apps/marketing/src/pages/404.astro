---
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
  <Nav />
  <main id="main" class="flex min-h-[70dvh] items-center justify-center px-5 pt-24 text-center">
    <div>
      <p class="kicker">404</p>
      <h1 class="h2 mt-3">This page doesn't exist.</h1>
      <p class="body-lg mt-3">It may have moved, or the link has a typo.</p>
      <a href="/" class="btn btn-primary mt-8">Back to the home page</a>
    </div>
  </main>
  <Footer />
</Base>
