---
import {
  ArrowRight,
  Banknote,
  BellRing,
  Check,
  FileText,
  FolderKanban,
  Globe,
  KeyRound,
  Lock,
  Mail,
  MapPin,
  MessagesSquare,
  PieChart,
  ScrollText,
  Split,
  UserCheck,
  Users,
} from "lucide-react";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import Calculators from "../islands/Calculators.tsx";
import ProductTour from "../islands/ProductTour.tsx";
import Base from "../layouts/Base.astro";
import { demoUrl, signUpUrl } from "../site";

const areas = [
  { name: "People", icon: Users, color: "var(--people)", line: "Your team, their managers, leave and onboarding.", points: ["Directory and org chart", "Leave with approvals and a team calendar", "Onboarding checklists"] },
  { name: "Work", icon: FolderKanban, color: "var(--work)", line: "Projects your team can actually follow.", points: ["Boards, lists, calendar and milestones", "Repeating work and templates", "Goals and workload"] },
  { name: "Collaboration", icon: MessagesSquare, color: "var(--collab)", line: "Talk about the work where the work is.", points: ["Channels and direct messages", "Comments on tasks, projects and invoices", "Decisions that are easy to find"] },
  { name: "Finance", icon: Banknote, color: "var(--finance)", line: "GST invoices to money in the bank.", points: ["Quotes, invoices and credit notes", "Online payments and reminders", "Receivables by client and by age"] },
];

const finance = [
  { icon: FileText, title: "GST worked out for you", text: "CGST and SGST or IGST from your state and your client's, HSN/SAC codes, and gap-free numbering for each financial year." },
  { icon: Split, title: "Instalments with interest", text: "Split an invoice into EMIs on the reducing balance. Each instalment's interest gets its own GST invoice." },
  { icon: BellRing, title: "Payments that follow up", text: "Razorpay links on every invoice, and a polite reminder the day after it's due, then weekly." },
  { icon: PieChart, title: "Know who owes what", text: "Billed, collected and due each month, and what's owed by client and by age." },
  { icon: Mail, title: "From your own address", text: "Invoices come from accounts@yourfirm.in. Verify your domain, or connect Gmail, Microsoft 365 or Zoho." },
  { icon: Check, title: "Not GST-registered?", text: "Leave GSTIN blank and invoices go out without GST. Add it the day you register." },
];

const steps = [
  ["A client asks", "They pick a service in your portal and upload what you ask for."],
  ["You agree the work", "Talk it through and send a quote. They accept it in the portal."],
  ["Work starts", "A project is created from your template, with the conversation attached."],
  ["Milestones bill", "A finished milestone drafts its GST invoice, ready to send."],
  ["You get paid", "They pay online, or in instalments. Reminders stop on their own."],
];

const trust = [
  { icon: KeyRound, title: "One sign-in, with roles", text: "People sign in with their Webrizen account. Roles decide who sees Finance or changes settings." },
  { icon: ScrollText, title: "Audit log", text: "Who issued an invoice, voided a payment or changed a setting, and when." },
  { icon: Lock, title: "Secrets stay secret", text: "Payment and mail server passwords are encrypted and never shown again." },
  { icon: MapPin, title: "Hosted in India", text: "Your data lives on servers in Mumbai." },
  { icon: UserCheck, title: "Clients see only theirs", text: "Each client sees their own requests, documents and invoices. Nothing else." },
  { icon: Globe, title: "Nothing to install", text: "Works in any browser, on a laptop or a phone." },
];

const faqs = [
  ["Who is Operant for?", "Growing businesses in India that serve clients: CA and CS firms, agencies, studios, consultancies and similar teams of 5 to a few hundred people."],
  ["Do we need a separate password?", "No. Everyone signs in with their Webrizen account (password, email code or Google). Admins invite people from Operant and choose their role."],
  ["We're not GST-registered. Can we still invoice?", "Yes. Leave GSTIN blank and invoices go out without GST. When you register, add it and Operant handles CGST, SGST and IGST."],
  ["Can clients pay online?", "Yes. Connect your Razorpay account and every invoice, or every instalment, gets a pay link. Payments are recorded automatically."],
  ["Can emails come from our own address?", "Yes. Verify your domain with a few DNS records, or connect your mail server. Until then emails go out with your name and replies come to you."],
  ["Can we switch off what we don't need?", "Yes. Turn off People, Work, Collaboration or Finance for the whole organization and they disappear from everyone's screen."],
];
---

<Base>
  <Nav />
  <main id="main">
    <!-- ================= Hero ================= -->
    <section id="hero" class="relative overflow-hidden">
      <div class="mx-auto grid max-w-[1200px] items-center gap-10 px-5 pt-32 pb-20 sm:px-8 lg:grid-cols-[1.1fr_1fr] lg:pt-36 lg:pb-24">
        <div>
          <a href="#how" class="intro inline-flex items-center gap-2 border border-line px-3 py-1.5 text-xs text-ink-2 transition-colors hover:border-line-2 hover:text-ink">
            <span class="bg-brand px-1.5 py-0.5 text-[10px] font-semibold text-[#09090b]">New</span>
            A portal where your clients request work and pay
            <ArrowRight size={13} />
          </a>
          <h1 class="h1 intro mt-7" style="--i:1">
            Your team, your work and your money. <span class="text-brand">In one place.</span>
          </h1>
          <p class="body-lg intro mt-6 max-w-xl" style="--i:2">
            Operant brings your people, projects, team chat, GST invoicing and a client portal together, so nothing lives in a spreadsheet, a WhatsApp group or someone's head.
          </p>
          <div class="intro mt-9 flex flex-wrap gap-3" style="--i:3">
            <a href={signUpUrl} class="btn btn-primary">Get started <span class="arrow" aria-hidden="true">→</span></a>
            <a href={demoUrl} class="btn">Book a demo</a>
          </div>
          <ul class="intro mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-3" style="--i:4">
            {["GST-ready invoicing", "A portal for your clients", "Sign in with Webrizen"].map((t) => (
              <li class="flex items-center gap-2"><Check size={14} color="var(--brand)" /> {t}</li>
            ))}
          </ul>
        </div>

        <!-- The emblem: WebGL rings, with static SVG rings until (or instead of) WebGL. -->
        <div class="relative mx-auto aspect-square w-full max-w-[460px]" aria-hidden="true">
          <svg class="absolute inset-[8%] text-brand/35" viewBox="-100 -100 200 200" fill="none" stroke="currentColor">
            {Array.from({ length: 10 }, (_, i) => <circle r={12 + i * 8.5} stroke-width="0.35" stroke-dasharray={i % 2 ? "1 2.5" : undefined} />)}
          </svg>
          <canvas id="rings" class="absolute inset-0 size-full opacity-0 transition-opacity duration-1000 data-[ready]:opacity-100"></canvas>
        </div>
      </div>
    </section>

    <!-- ================= Product ================= -->
    <section id="product" class="border-t border-line">
      <div class="mx-auto max-w-[1200px] px-5 py-24 sm:px-8">
        <div class="reveal max-w-2xl">
          <p class="kicker">A look inside</p>
          <h2 class="h2 mt-3">Everything your firm runs on, connected.</h2>
          <p class="body-lg mt-4">A client request becomes a project, a finished milestone becomes an invoice, and an approved leave shows on everyone's calendar. Pick an area below, or let it run.</p>
        </div>
        <div class="reveal beam mt-12" style="--i:1">
          <ProductTour client:visible />
        </div>

        <div class="mt-16 grid border-t border-l border-line sm:grid-cols-2 lg:grid-cols-4">
          {
            areas.map((a, i) => (
              <article class="reveal accent-top border-r border-b border-line p-6 transition-colors hover:bg-card" style={`--accent:${a.color};--i:${i}`}>
                <span class="flex size-9 items-center justify-center border border-line-2">
                  <a.icon size={17} strokeWidth={1.6} color={a.color} />
                </span>
                <h3 class="h3 mt-5">{a.name}</h3>
                <p class="mt-1.5 text-sm text-ink-2">{a.line}</p>
                <ul class="mt-5 space-y-2 border-t border-line pt-5 text-sm text-ink-2">
                  {a.points.map((p) => (
                    <li class="flex gap-2.5">
                      <Check size={14} color={a.color} class="mt-1 shrink-0" />
                      {p}
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= Finance ================= -->
    <section id="finance" class="border-t border-line">
      <div class="mx-auto max-w-[1200px] px-5 py-24 sm:px-8">
        <div class="reveal grid gap-6 lg:grid-cols-2 lg:items-end">
          <div>
            <p class="kicker">Finance</p>
            <h2 class="h2 mt-3">Invoices your accountant will like.</h2>
          </div>
          <p class="body-lg">Made for how business works in India: GST, financial years, UPI and bank transfers, and clients who need a nudge to pay.</p>
        </div>
        <div class="mt-12 grid border-t border-l border-line md:grid-cols-2 lg:grid-cols-3">
          {
            finance.map((f, i) => (
              <div class="reveal accent-top border-r border-b border-line p-6 transition-colors hover:bg-card" style={`--i:${i % 3}`}>
                <f.icon size={18} strokeWidth={1.6} color="var(--brand)" />
                <h3 class="h3 mt-4">{f.title}</h3>
                <p class="mt-2 text-sm text-ink-2">{f.text}</p>
              </div>
            ))
          }
        </div>

        <div id="try" class="mt-20 scroll-mt-24">
          <div class="reveal max-w-2xl">
            <p class="kicker">Try it</p>
            <h3 class="h2 mt-3 !text-[clamp(1.6rem,2.4vw,2.1rem)]">The same maths as your invoices.</h3>
            <p class="body-lg mt-3">These calculators run the exact code Operant uses on real invoices.</p>
          </div>
          <div class="reveal mt-8" style="--i:1">
            <Calculators client:visible />
          </div>
        </div>
      </div>
    </section>

    <!-- ================= How it works ================= -->
    <section id="how" class="border-t border-line">
      <div class="mx-auto max-w-[1200px] px-5 py-24 sm:px-8">
        <div class="reveal max-w-2xl">
          <p class="kicker">The client portal</p>
          <h2 class="h2 mt-3">From a client's request to money in the bank.</h2>
          <p class="body-lg mt-4">Your clients get their own simple site: no passwords, just a code by email. They see your team's names and faces, never your internal chat.</p>
        </div>

        <!-- A thin line that fills as you scroll; each step lights up as it's reached. -->
        <div class="relative mt-14" data-scrub>
          <div class="absolute top-4 right-0 left-0 hidden h-px bg-line lg:block" aria-hidden="true">
            <div class="h-full origin-left bg-brand" style="transform: scaleX(var(--p, 0))"></div>
          </div>
          <ol class="relative grid gap-8 lg:grid-cols-5 lg:gap-6">
            {
              steps.map(([t, d], i) => (
                <li class="relative max-lg:border-l max-lg:border-line max-lg:pl-6" style={`--on: clamp(0, (var(--p, 0) - ${(i / 5).toFixed(2)}) * 10, 1)`}>
                  <span
                    class="flex size-8 items-center justify-center border text-xs font-semibold max-lg:absolute max-lg:-left-4"
                    style="border-color: color-mix(in oklab, var(--brand) calc(var(--on) * 100%), var(--line-2)); background: color-mix(in oklab, var(--brand) calc(var(--on) * 100%), var(--paper)); color: color-mix(in oklab, #09090b calc(var(--on) * 100%), var(--ink-3))"
                  >
                    {i + 1}
                  </span>
                  <h3 class="h3 mt-5 max-lg:mt-0">{t}</h3>
                  <p class="mt-1.5 text-sm text-ink-2">{d}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <!-- ================= Trust ================= -->
    <section class="border-t border-line">
      <div class="mx-auto max-w-[1200px] px-5 py-24 sm:px-8">
        <div class="reveal max-w-2xl">
          <p class="kicker">Built to be trusted</p>
          <h2 class="h2 mt-3">Your data, your rules.</h2>
        </div>
        <div class="mt-12 grid gap-x-10 gap-y-9 sm:grid-cols-2 lg:grid-cols-3">
          {
            trust.map((t, i) => (
              <div class="reveal flex gap-4 border-t border-line pt-6" style={`--i:${i % 3}`}>
                <t.icon size={18} strokeWidth={1.6} color="var(--ink-2)" class="mt-0.5 shrink-0" />
                <div>
                  <h3 class="text-[15px] font-semibold">{t.title}</h3>
                  <p class="mt-1 text-sm text-ink-2">{t.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= Questions ================= -->
    <section id="faq" class="border-t border-line">
      <div class="mx-auto grid max-w-[1200px] gap-10 px-5 py-24 sm:px-8 lg:grid-cols-[1fr_2fr]">
        <div class="reveal">
          <p class="kicker">Questions</p>
          <h2 class="h2 mt-3">Asked often.</h2>
          <p class="mt-4 text-ink-2">Something else? <a href={demoUrl} class="text-ink underline decoration-line-2 underline-offset-4 hover:decoration-brand">Write to us</a>.</p>
        </div>
        <div class="reveal border-t border-line" style="--i:1">
          {
            faqs.map(([q, a]) => (
              <details class="group border-b border-line">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-[16px] font-medium transition-colors hover:text-brand-ink">
                  {q}
                  <span class="relative size-3 shrink-0" aria-hidden="true">
                    <span class="absolute top-1/2 left-0 h-px w-3 bg-ink-3" />
                    <span class="absolute top-0 left-1/2 h-3 w-px bg-ink-3 transition-transform duration-300 group-open:scale-y-0" />
                  </span>
                </summary>
                <p class="-mt-1 max-w-2xl pb-5 text-ink-2">{a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= Get started ================= -->
    <section class="px-5 pb-24 sm:px-8">
      <div class="reveal beam panel relative mx-auto max-w-[1200px] overflow-hidden px-6 py-16 text-center sm:py-20">
        <div class="pointer-events-none absolute -bottom-32 left-1/2 h-64 w-[640px] -translate-x-1/2 rounded-[50%] opacity-30 blur-3xl" style="background: var(--brand)" aria-hidden="true"></div>
        <div class="relative">
          <h2 class="h2 mx-auto max-w-2xl">Run the whole business from one place.</h2>
          <p class="body-lg mx-auto mt-4 max-w-lg">Set it up in an afternoon: bring in your team, add your clients and send your first invoice.</p>
          <div class="mt-8 flex flex-wrap justify-center gap-3">
            <a href={signUpUrl} class="btn btn-primary">Get started <span class="arrow" aria-hidden="true">→</span></a>
            <a href={demoUrl} class="btn">Book a demo</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<script>
  import { mountRings } from "../scripts/rings";
  const canvas = document.getElementById("rings") as HTMLCanvasElement | null;
  const hero = document.getElementById("hero");
  if (canvas && hero) mountRings(canvas, hero);
</script>
