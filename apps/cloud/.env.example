# ---- App ----
# Public URL of the app (the SPA and API share one origin).
APP_URL=http://localhost:5173
# 32+ random characters: openssl rand -base64 32
SESSION_SECRET=

# ---- Webrizen SSO (Admin → Products → Operant → Sign-in; redirect {APP_URL}/auth/callback) ----
WEBRIZEN_SSO_ISSUER=https://accounts.webrizen.com/api/auth
WEBRIZEN_SSO_CLIENT_ID=
WEBRIZEN_SSO_CLIENT_SECRET=

# ---- Database ----
# Supabase transaction pooler URL (port 6543). Leave empty to use a local
# embedded Postgres (PGlite) in .data/ for development.
DATABASE_URL=

# ---- Supabase (files, realtime) ----
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=operant
# Encrypts tenants' Razorpay secrets (defaults to SESSION_SECRET). Set once, keep forever.
ENCRYPTION_KEY=

# Signs the short-lived Supabase token used by the browser for Realtime.
# Use the project's JWT secret (HS256 shared secret).
SUPABASE_JWT_SECRET=
# Publishable (anon) key: lets browsers connect to Realtime with the minted token.
SUPABASE_PUBLISHABLE_KEY=

# ---- Email (Resend) ----
# Leave empty to log emails to the console instead (invoices still get a shareable link).
# 1. Create an API key at resend.com.  2. Verify the sending domain (DNS records) in Resend.
# 3. EMAIL_FROM must use that verified domain. Check with Finance settings, "Send test email".
RESEND_API_KEY=
EMAIL_FROM="Operant <no-reply@webrizen.com>"

# ---- Jobs ----
# Shared secret for /api/cron (sent by Supabase pg_cron as a bearer token).
CRON_SECRET=

# ---- Local development only ----
# Sign in without SSO as a demo owner. Ignored in production.
DEV_AUTH=true
